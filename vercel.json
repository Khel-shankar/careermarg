{
  "version": 2,
  "name": "careermarg",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/db.php",
      "destination": "/api/db.js"
    },
    {
      "source": "/api/sync.php",
      "destination": "/api/sync.js"
    },
    {
      "source": "/api/auth.php",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/counselor.php",
      "destination": "/api/counselor.js"
    }
  ]
}
